{
  "name": "dwarf-forge",
  "compatibility_date": "2026-10-12",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "dwarf-forge.gizeta.eu.org",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "preview_urls": false
}
